)\n        print(subprocess.check_output(['git', 'show', '-s', '--format=%ci %H', 'HEAD'], text=True))\n    else:\n        print(\"Warning: could not determine a pre-pallas commit; staying on current HEAD.\")\n\n# Sanity: detect pallas import in current tree\nhas_pallas = False\ntry:\n    with open('MaxText/layers/attentions.py', 'r') as f:\n        has_pallas = 'pallas.ops.attention' in f.read()\nexcept FileNotFoundError:\n    pass\nprint(\"attentions.py uses pallas:\", has_pallas)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-09-10T15:06:16.835839Z","iopub.execute_input":"2025-09-10T15:06:16.836152Z","iopub.status.idle":"2025-09-10T15:06:48.390523Z","shell.execute_reply.started":"2025-09-10T15:06:16.836126Z","shell.execute_reply":"2025-09-10T15:06:48.383165Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.10/pty.py:89: RuntimeWarning: os.fork() was called. os.fork() is incompatible with multithreaded code, and JAX is multithreaded, so this will likely lead to a deadlock.\n  pid, fd = os.forkpty()\n","output_type":"stream"},{"name":"stdout","text":"Cloning into 'maxtext'...\nremote: Enumerating objects: 55709, done.\u001b[K\nremote: Counting objects: 100% (94/94), done.\u001b[K\nremote: Compressing objects: 100% (52/52), done.\u001b[K\nremote: Total 55709 (delta 69), reused 42 (delta 42), pack-reused 55615 (from 2)\u001b[K\nReceiving objects: 100% (55709/55709), 317.29 MiB | 29.74 MiB/s, done.\nResolving deltas: 100% (41359/41359), done.\n","output_type":"stream"},{"name":"stderr","text":"/usr/local/lib/python3.10/site-packages/IPython/core/magics/osm.py:417: UserWarning: This is now an optional IPython functionality, setting dhist requires you to install the `pickleshare` library.\n  self.shell.db['dhist'] = compress_dhist(dhist)[-100:]\n","output_type":"stream"},{"name":"stdout","text":"/kaggle/working/maxtext\nFirst commit with pallas.ops.attention: 2a6154f254bf5dbe67e659360775a83a797ed7f9\n","output_type":"stream"},{"name":"